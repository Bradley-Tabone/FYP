# =============================================================================
# Android (mobile-app/)
# =============================================================================
*.iml
.gradle
mobile-app/local.properties
mobile-app/.idea/caches
mobile-app/.idea/libraries
mobile-app/.idea/modules.xml
mobile-app/.idea/workspace.xml
mobile-app/.idea/navEditor.xml
mobile-app/.idea/assetWizardSettings.xml
.DS_Store
mobile-app/build
mobile-app/captures
.externalNativeBuild
.cxx
local.properties

# =============================================================================
# Dataset images - large, re-downloadable from Roboflow
# Labels and COCO JSON annotations are kept (small, version-controlled)
# =============================================================================
ml-training/data/train/images/
ml-training/data/valid/images/
ml-training/data/test/images/

# Label cache files generated by Ultralytics
ml-training/data/**/*.cache

# =============================================================================
# Model weights and exports - too large for GitHub
# val* run directories are kept (confusion matrices, PR curves, CSVs)
# =============================================================================

# PyTorch weights
**/*.pt
**/*.pth

# Export formats - *.onnx tracked via Git LFS (see .gitattributes)
**/*.tflite
!mobile-app/app/src/main/assets/*.tflite

# RF-DETR run directory (3.6 GB - all training checkpoints)
ml-training/notebooks/runs/rfdetr/

# Weights subdirectories inside each detect run (kept: plots, CSVs, args.yaml)
ml-training/notebooks/runs/detect/*/weights/

# TFLite export artefacts - SavedModel directories produced during export
ml-training/notebooks/runs/detect/*/tflite_export/

# =============================================================================
# Downloaded pretrained model files in project root / notebooks dir
# =============================================================================
ml-training/notebooks/*.pt
ml-training/models/*.pt

# =============================================================================
# Windows / WSL metadata
# =============================================================================
*:Zone.Identifier

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# =============================================================================
# JVM crash logs
hs_err_pid*.log
replay_pid*.log
mobile-app/hs_err_pid*.log
mobile-app/replay_pid*.log

# Large data directories - images only; labels/annotations are tracked
# =============================================================================
ml-training/data_backup_pre_cull/
ml-training/data_backup_post_cull/
ml-training/sunglasses-wallet-keys-custom/
ml-training/notebooks/runs/detect/*/train_batch*.jpg
ml-training/notebooks/runs/detect/*/val_batch*.jpg
ml-training/notebooks/runs/detect/*/labels.jpg
ml-training/notebooks/runs/detect/runs/*/train_batch*.jpg
ml-training/notebooks/runs/detect/runs/*/val_batch*.jpg
